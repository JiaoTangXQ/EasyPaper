<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.easypaper.gloss-worker</string>
    <key>ProgramArguments</key>
    <array>
      <string>__RUN_SCRIPT__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/gloss-worker.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/gloss-worker.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
      <key>HOME</key>
      <string>__HOME__</string>
    </dict>
  </dict>
</plist>
