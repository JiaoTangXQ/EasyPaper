# Copy to ~/.config/easypaper/gloss-worker.env (install script does this). Do not commit secrets.

EASYPAPER_REPO=/path/to/EasyPaper
EASYPAPER_SERVER_URL=https://121.40.108.230:8443
GLOSS_WORKER_TOKEN_FILE=${HOME}/.config/easypaper/gloss-worker.token
GLOSS_WORKER_LABEL=mac-jiaotang
EASYPAPER_GLOSS_CONCURRENCY=4

