# Copy to ~/.config/easypaper/gloss-worker.env (install script does this). Do not commit secrets.

EASYPAPER_REPO=/path/to/EasyPaper
# Set this locally to the private deployment URL. Do not commit a real host/IP.
EASYPAPER_SERVER_URL=https://papers.example.com:8443
GLOSS_WORKER_TOKEN_FILE=${HOME}/.config/easypaper/gloss-worker.token
GLOSS_WORKER_LABEL=mac-worker
EASYPAPER_GLOSS_CONCURRENCY=4
EASYPAPER_AI_PROVIDER=api

# Keep these values in this private file (or backend/config/config.yaml), not
# in Git. They should match the API provider configured on the server.
# LLM_API_KEY=
# LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
# LLM_MODEL=deepseek-v4.1-flash-1017

# Optional Cursor override for local development only:
# APP_CONFIG_PATH=${EASYPAPER_REPO}/backend/config/config.yaml
# EASYPAPER_CURSOR_EXECUTABLE=${HOME}/.local/bin/cursor-j
# EASYPAPER_CURSOR_MODEL=grok-4.7-high-fast
