# Install only after replacing the domain and certificate paths.
# This is an additional virtual host for an existing Nginx installation.
server {
    listen 80;
    server_name papers.example.com;
    return 308 https://papers.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name papers.example.com;
    ssl_certificate /etc/letsencrypt/live/papers.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/papers.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 129m;
    client_header_timeout 10s;
    client_body_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Replace client-supplied headers at the public boundary.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 300s;
    }
}
