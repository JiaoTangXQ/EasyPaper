# Prefer: python3 scripts/prepare_server.py --domain papers.example.com
# .env is private (chmod 600), never commit it.
DOMAIN=papers.example.com
BIND_IP=0.0.0.0
# Use hex secrets (openssl rand -hex 32); database password is embedded in a URL.
POSTGRES_PASSWORD=
EASYPAPER_SECRET_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional Codex CLI mode, after a successful real inference check:
# docker compose -f docker-compose.prod.yml -f deploy/compose.codex.yml up -d --no-build
# CODEX_RUNTIME_DIR=/path/to/vendor/x86_64-unknown-linux-musl
# CODEX_MODEL=gpt-5.5

# Optional: an existing host Nginx terminates HTTPS for EasyPaper.
# Keep these defaults for a dedicated server with Caddy on public 80/443.
# BIND_IP=127.0.0.1
# HTTP_PORT=18081
# HTTPS_PORT=18444
# CADDY_SITE_ADDRESS=:80
# CADDY_TRUSTED_PROXIES=172.20.0.1/32  # use the actual easypaper_app gateway
# DATABASE_MEMORY=256m
# BACKEND_MEMORY=1g
# BACKEND_CPUS=1
# BACKEND_TMPFS_SIZE=192m
# Starting point for an 8 GB machine; adjust after load testing.
BACKEND_MEMORY=4g
BACKEND_CPUS=2
# Optional: prebuilt images in your private Alibaba Cloud ACR registry.
# BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-team/easypaper-backend:version
# FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-team/easypaper-frontend:version
